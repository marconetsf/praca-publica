# Copie para .env e preencha. O .env é gitignored — credenciais NUNCA vão para o git.

# Raízes de dados: vazio = data/ local (tudo na mesma pasta).
# Na cloud são dois buckets (ARQUITETURA §2): raw isolado do resto.
# PRACA_DATA_ROOT=s3://praca-dados    # staging/, marts/, serving/, catalog/
# PRACA_RAW_ROOT=s3://praca-raw       # só raw/{fonte}/{AAAA-MM-DD}/

# Cloudflare R2 (dashboard → R2 → Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Telegram (bot criado via @BotFather; chat_id do canal/conversa de operações)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Portal da Transparência (Fase 2) — https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# CGU_API_TOKEN=
