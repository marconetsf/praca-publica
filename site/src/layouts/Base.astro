---
/**
 * Layout base: a casca de toda página e o único lugar com estilo global.
 *
 * Os valores moram em `estilos/tokens.css`; aqui ficam só as regras de
 * elemento (corpo, link, foco, tabela) e três utilitários que qualquer
 * componente pode usar: `.numero`, `.oculto-visual` e `.hachura`.
 *
 * Zero JS para ler (PRODUTO §3). Nada aqui depende de script.
 */
import "../estilos/tokens.css";

const { titulo, descricao, naoIndexar = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descricao && <meta name="description" content={descricao} />}
    {naoIndexar && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={titulo} />
    {descricao && <meta property="og:description" content={descricao} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      /* Porcentagem, não px: quem aumentou a fonte padrão do celular continua
         mandando na escala. 106,25% = 17 px quando o navegador está no padrão. */
      html {
        font-size: 106.25%;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        font-family: var(--fonte-texto);
        font-size: var(--texto-base);
        line-height: var(--linha-texto);
        color: var(--cor-tinta);
        background: var(--cor-papel);
      }

      /* Âncora não pode esconder o próprio título embaixo da borda da tela. */
      :target {
        scroll-margin-top: var(--esp-4);
      }

      h1,
      h2,
      h3 {
        line-height: var(--linha-titulo);
        text-wrap: balance;
      }

      p {
        margin: 0 0 var(--esp-4);
      }

      a {
        color: var(--cor-primaria);
      }
      a:hover {
        color: var(--cor-primaria-escura);
      }

      /* Foco sempre visível e sempre com folga: quem navega por teclado precisa
         enxergar onde está, inclusive sobre fundo escuro de card. */
      :focus-visible {
        outline: 3px solid var(--cor-foco);
        outline-offset: 2px;
        border-radius: var(--raio-p);
      }

      /* Números alinham na vertical: 1.354 e 1.030 têm que ter a mesma largura,
         senão o olho compara os dígitos errados. */
      .numero {
        font-variant-numeric: tabular-nums;
      }

      /* Texto que só o leitor de tela ouve. Usado para desambiguar rótulos
         repetidos (três "Como este número foi calculado?" na mesma página). */
      .oculto-visual {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      /* A marca visual da ausência de dado. Diagonal, nunca cinza chapado:
         chapado lê como "desativado"; hachura lê como "buraco". Acompanha
         sempre um texto dizendo o motivo — cor e textura nunca informam sozinhas. */
      .hachura {
        background-image: repeating-linear-gradient(
          45deg,
          var(--cor-ausencia-fundo),
          var(--cor-ausencia-fundo) 6px,
          var(--cor-ausencia-traco) 6px,
          var(--cor-ausencia-traco) 12px
        );
      }

      .pular-para-conteudo {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--cor-papel);
        color: var(--cor-primaria);
        padding: var(--esp-3);
        z-index: 2;
      }
      .pular-para-conteudo:focus {
        left: 0;
      }

      header.topo {
        border-bottom: 1px solid var(--cor-borda);
        padding: var(--esp-3) var(--esp-4);
      }
      header.topo a {
        display: inline-flex;
        align-items: center;
        min-height: var(--alvo-toque);
        text-decoration: none;
        font-weight: var(--peso-forte);
        color: var(--cor-tinta);
      }

      main {
        max-width: var(--medida-texto);
        margin: 0 auto;
        padding: var(--esp-4) var(--esp-4) var(--esp-8);
      }

      .rodape-site {
        margin-top: var(--esp-7);
        padding-top: var(--esp-4);
        border-top: 1px solid var(--cor-borda);
        color: var(--cor-neutra);
        font-size: var(--texto-menor);
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="pular-para-conteudo" href="#conteudo">Ir direto para o conteúdo</a>
    <header class="topo"><a href="/">Praça Pública</a></header>
    <main id="conteudo">
      <slot />
      <p class="rodape-site">
        Dados públicos oficiais, com fonte e data em cada número. Este é um MVP em
        construção — a cobertura ainda não é nacional.
        <a href="/fontes">Veja de onde vêm os dados</a>, o que está guardado e o que
        ainda não conseguimos obter. <a href="/feedback">Achou um erro?</a>
      </p>
    </main>
  </body>
</html>
