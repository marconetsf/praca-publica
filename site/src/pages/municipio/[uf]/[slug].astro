---
/**
 * A página do município — o produto central (PRODUTO §2).
 *
 * Slug por UF porque nome de município não é único no país: "bom-jesus" existe
 * em 5 estados. O código IBGE fica no rodapé, nunca na URL principal.
 *
 * A página percorre o **catálogo** de indicadores, não a lista do município: é
 * assim que o card que falta aparece como falta, em vez de sumir. Uma cidade
 * sem o dado de impostos precisa mostrar que o dado não existe — isso também é
 * informação pública, e é a regra de ferro do PRODUTO §2.5.
 */
import Base from "../../../layouts/Base.astro";
import Cabecalho from "../../../components/Cabecalho.astro";
import Titulo from "../../../components/Titulo.astro";
import Lista from "../../../components/Lista.astro";
import CardIndicador from "../../../components/CardIndicador.astro";
import SemDado from "../../../components/SemDado.astro";
import {
  lerIndice,
  lerMunicipio,
  catalogoIndicadores,
  formatarNumero,
  formatarValor,
  classificarComparacao,
  FRASE_RESUMO,
  GRUPOS_DE_INDICADOR,
  nomeUf,
  motivoSemDado,
} from "../../../dados.js";

export function getStaticPaths() {
  return lerIndice().map((m) => ({
    params: { uf: m.uf.toLowerCase(), slug: m.slug },
    props: { codigoIbge: m.codigo_ibge },
  }));
}

const { codigoIbge } = Astro.props;
const m = lerMunicipio(codigoIbge);
const estado = nomeUf(m.uf);

const titulo = `${m.nome} (${m.uf}): para onde vai o dinheiro — Praça Pública`;
const descricao =
  `Veja em linguagem simples os dados públicos de ${m.nome} (${m.uf}): ` +
  `orçamento e arrecadação. Fonte: SICONFI/Tesouro Nacional, dados de ${m.ano_referencia}.`;

// O catálogo dá a ordem; o município diz o que tem. O que ele não tem vira
// card de ausência, na mesma posição em que estaria o número.
const publicados = new Map(m.indicadores.map((i) => [i.id, i]));
const blocos = catalogoIndicadores().map((def) => ({
  definicao: def,
  indicador: publicados.get(def.id) ?? null,
}));
const faltantes = blocos.filter((b) => !b.indicador);

// "Em resumo": as frases que aparecem no print de WhatsApp. Uma delas pode ser
// uma lacuna de dado — transparência ativa, não omissão (PRODUTO §2 regra 1).
const comComparacao = m.indicadores.filter((i) => i.comparacao);
const semComparacao = m.indicadores.filter((i) => !i.comparacao);

// Usa a MESMA classificação do card: comparação binária aqui produzia "menos
// que o típico" para um valor idêntico à mediana, contradizendo o card abaixo.
const resumo = comComparacao.slice(0, 2).map((i) => {
  const classe = classificarComparacao(i.valor, i.comparacao);
  return (
    `${i.nome}: ${formatarValor(i.valor, i.unidade)} em ${i.ano_referencia} — ` +
    `${FRASE_RESUMO[classe]} ` +
    `(mediana ${formatarValor(i.comparacao.mediana_parecidos, i.unidade)}).`
  );
});

// Cidade cujo grupo é pequeno demais (Porto Velho está entre as 4 do Norte
// acima de 500 mil) ficaria com um resumo sem nenhum número — justamente o
// bloco que vira print. Então entram os valores, com a falta de referência dita
// na mesma frase: número sem régua, mas com o aviso colado nele.
const preenchidos = semComparacao.slice(0, Math.max(0, 2 - resumo.length));
for (const i of preenchidos) {
  resumo.push(
    `${i.nome}: ${formatarValor(i.valor, i.unidade)} em ${i.ano_referencia} — ` +
      "ainda sem comparação, porque o grupo de cidades parecidas tem menos de 5 " +
      "com este dado publicado."
  );
}

// A lacuna entra no resumo — transparência ativa (PRODUTO §2 regra 1) — mas em
// UMA linha. Com 15 indicadores, listar cada falta empurraria os números para
// fora do print de WhatsApp, que é onde o resumo é lido.
if (faltantes.length === 1) {
  const { definicao } = faltantes[0];
  resumo.push(
    `Sem dado de "${definicao.nome}" em ${m.ano_referencia}. ` +
      (definicao.ausenciaSignifica ?? "")
  );
} else if (faltantes.length > 1) {
  resumo.push(
    `${faltantes.length} dos ${blocos.length} números não saíram para ${m.nome} em ` +
      `${m.ano_referencia}: ${faltantes.map((b) => b.definicao.nome).join(", ")}. ` +
      "Cada card abaixo explica o motivo da falta."
  );
}

if (semComparacao.length && preenchidos.length === 0) {
  resumo.push(
    semComparacao.length === 1
      ? "Um dos números ainda não tem comparação: o grupo de cidades parecidas tem menos de 5 com dado publicado."
      : `${semComparacao.length} números ainda não têm comparação: o grupo de cidades parecidas tem menos de 5 com dado publicado.`
  );
}

const migalha = [{ texto: "Brasil", href: "/" }, { texto: estado }, { texto: m.nome }];
const apoio =
  `${formatarNumero(m.populacao)} habitantes · ${estado}` +
  (m.eh_capital ? " · capital do estado" : "");
---

<Base titulo={titulo} descricao={descricao}>
  <Cabecalho titulo={`${m.nome} — ${m.uf}`} apoio={apoio} migalha={migalha} />

  <section class="resumo" aria-labelledby="em-resumo">
    <Titulo nivel={2} tamanho={3} id="em-resumo">Em resumo</Titulo>
    <Lista variante="resumo" itens={resumo} />
  </section>

  {
    /* Um bloco por grupo declarado no mart. 15 cards numa lista só não contam
       história nenhuma; separados em "de onde vem", "para onde vai" e "por
       área", a página responde as perguntas na ordem em que elas aparecem. */
    GRUPOS_DE_INDICADOR.map((grupo) => {
      const doGrupo = blocos.filter(({ definicao }) => definicao.grupo === grupo.id);
      if (doGrupo.length === 0) return null;
      return (
        <section aria-labelledby={grupo.id}>
          <Titulo nivel={2} id={grupo.id} ancora>
            {grupo.titulo}
          </Titulo>
          <p class="apoio-secao">{grupo.apoio}</p>
          {doGrupo.map(({ definicao, indicador }) =>
            indicador ? (
              <CardIndicador indicador={indicador} nomeMunicipio={m.nome} />
            ) : (
              <SemDado titulo={definicao.nome} fonte={`${definicao.orgao} (${definicao.fonte})`}>
                <p>
                  {motivoSemDado(
                    m.nome,
                    m.ano_referencia,
                    definicao.orgao,
                    definicao.ausenciaSignifica
                  )}
                </p>
                <p class="explica">{definicao.descricao}</p>
              </SemDado>
            )
          )}
        </section>
      );
    })
  }

  {
    /* Só aparece quando falta algo: um convite a contestar num município com
       a página completa seria ruído, e o leitor aprende a ignorar o aviso. */
    faltantes.length > 0 && (
      <p class="contestar">
        Acha que {m.nome} enviou este dado?{" "}
        <a href="/feedback">Veja como conferir na fonte</a>.
      </p>
    )
  }

  <p class="identificacao numero">
    Código IBGE {m.codigo_ibge} · dados de {m.ano_referencia} ·
    <a href={`/dados/municipio/${m.codigo_ibge}.json`}>baixar os dados desta página</a>
  </p>
</Base>

<style>
  /* O resumo é o bloco que vira print: fundo suave e barra à esquerda para se
     destacar sem virar caixa colorida, que numa tela pequena rouba o número. */
  .resumo {
    background: var(--cor-papel-suave);
    border-left: 4px solid var(--cor-primaria);
    border-radius: 0 var(--raio-p) var(--raio-p) 0;
    padding: var(--esp-4);
    margin-bottom: var(--esp-6);
  }
  .explica {
    color: var(--cor-neutra);
    font-size: var(--texto-menor);
  }
  .apoio-secao {
    margin-top: calc(-1 * var(--esp-2));
    color: var(--cor-neutra);
    font-size: var(--texto-menor);
  }
  .contestar {
    font-size: var(--texto-menor);
  }
  .identificacao {
    margin-top: var(--esp-6);
    font-size: var(--texto-mini);
    color: var(--cor-neutra);
  }
</style>
